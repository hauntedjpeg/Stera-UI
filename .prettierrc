{
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "apps/docs/app/globals.css",
  "tailwindFunctions": ["cn", "cva"],
  "overrides": [
    {
      "files": "apps/figma-bridge/**",
      "options": {
        "tailwindStylesheet": "apps/figma-bridge/src/ui/index.css"
      }
    },
    {
      "files": "apps/figma-colors/**",
      "options": {
        "tailwindStylesheet": "apps/figma-colors/src/ui/index.css"
      }
    }
  ]
}
